# Copy to .env (gitignored) and fill in real values for local development.
# Production values live in the deploy environment's secret store, never here.

NODE_ENV=development
PORT=3000

# Database — example. Replace once a database is chosen via ExecPlan.
# DATABASE_URL=postgres://user:pass@localhost:5432/dbname

# Auth — example. Replace once an auth scheme is chosen via ExecPlan.
# SESSION_SECRET=<min-32-chars-random>
